# ===== GINA Platform Environment Variables =====
# انسخ هذا الملف إلى .env وأضف القيم الحقيقية

# === Platform ===
NODE_ENV=development
PLATFORM_NAME=gina-platform
PLATFORM_VERSION=1.0.0

# === API Gateway ===
API_PORT=3000
API_BASE_URL=http://localhost:3000

# === Security ===
# CRITICAL: استخدم مفاتيح آمنة في الإنتاج!
MASTER_ENCRYPTION_KEY=your_256_bit_hex_key_here_64_chars
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
AUDIT_SIGNING_KEY=your_audit_signing_key_here

# === Google Firebase ===
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_PRIVATE_KEY=your-firebase-admin-private-key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# === Gemini AI ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=2048

# === Google Cloud Platform ===
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json

# === Google Workspace ===
GOOGLE_WORKSPACE_DOMAIN=your-domain.com
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# === GINA Pay ===
GINA_PAY_MERCHANT_ID=your-merchant-id
GINA_PAY_API_KEY=your-pay-api-key
GINA_PAY_WEBHOOK_SECRET=your-webhook-secret
GINA_PAY_ENVIRONMENT=sandbox

# === Database ===
DATABASE_URL=postgresql://gina:gina_secret@localhost:5432/gina_db
DB_PASSWORD=gina_secret

# === Redis ===
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=gina_redis_secret

# === Monitoring ===
GRAFANA_PASSWORD=admin123

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# === CORS ===
CORS_ORIGINS=http://localhost:3100,https://yourdomain.com
